###> Apache ###
SERVER_NAME='ems_standard.localhost'
SERVER_ALIASES='*'
JOBS_ENABLED='${JOBS_ENABLED}'
APACHE_CACHE_CONTROL='immutable, max-age=63072000, public'

HTTP_CUSTOM_FORWARDED_HOST='${HTTP_CUSTOM_FORWARDED_HOST}'
HTTP_CUSTOM_FORWARDED_FOR='${HTTP_CUSTOM_FORWARDED_FOR}'
HTTP_CUSTOM_FORWARDED_PROTO='${HTTP_CUSTOM_FORWARDED_PROTO}'
HTTP_CUSTOM_FORWARDED_PORT='${HTTP_CUSTOM_FORWARDED_PORT}'
###< Apache ###

###> Symfony ###
APP_ENV='${APP_ENV}'
APP_SECRET='b97d8a26f9bd4d2aad7d1665e99cb06494e5f85b'
MAILER_URL='${MAILER_URL}'
TRUSTED_PROXIES='${APP_TRUSTED_PROXIES}'
TRUSTED_HOSTS='${APP_TRUSTED_HOSTS}'
###< Symfony ###

###> Redis ###
REDIS_HOST='${REDIS_HOST}'
REDIS_PORT='${REDIS_PORT}'
###< Redis ###

###> Database ###
DB_HOST='${DB_HOST}'
DB_DRIVER='${DB_DRIVER}'
DB_USER='${DB_USER}'
DB_PASSWORD='${DB_PASSWORD}'
DB_PORT='${DB_PORT}'
DB_NAME='${DB_NAME}'
DB_SCHEMA='${DB_SCHEMA_NAME}'
DB_VERSION=${DB_VERSION}
###< Database ###

###> EMSCommonBundle ###
EMS_ELASTICSEARCH_HOSTS='${ES_CLUSTER_CONFIG}'
EMS_STORAGES='[{"type":"s3","credentials":{"version":"2006-03-01","credentials":{"key":"${S3_ACCESS_KEY_ID}","secret":"${S3_SECRET_ACCESS_KEY}"},"region":"${S3_DEFAULT_REGION}","endpoint":"${S3_ENDPOINT_URL}","use_path_style_endpoint":true},"bucket":"${S3_BUCKET_NAME}"}]'
EMS_CACHE='${APP_CACHE}'
EMS_CACHE_PREFIX='ems_standard_admin_'
EMS_METRIC_ENABLED='${METRICS_ENABLED}'
EMS_EXCLUDED_CONTENT_TYPES='["ems_standard_route","ems_standard_template","ems_standard_template_ems","ems_standard_label"]'
###< EMSCommonBundle ###

###> EMSCoreBundle ###
EMSCO_INSTANCE_ID='${APP_INSTANCE_ID}'
EMSCO_NAME='${APP_NAME}'
EMSCO_SHORTNAME='${APP_SHORTNAME}'
EMSCO_THEME_COLOR='${APP_THEME_COLOR}'
EMSCO_URL_USER='${APP_BACKEND_PROXY_URL}'
EMSCO_FROM_EMAIL_ADDRESS='${APP_FROM_EMAIL_ADDRESS}'
EMSCO_FROM_EMAIL_NAME='${APP_FROM_EMAIL_NAME}'
EMSCO_GROUP_FEATURE=true
EMSCO_TRIGGER_JOB_FROM_WEB='false'
EMSCO_TIKA_SERVER='${APP_TIKA_SERVER}'
EMSCO_PRE_GENERATED_OUUIDS='true'
EMSCO_CIRCLES_OBJECT=''
###< EMSCoreBundle ###

###> EMSCoreBundle/LDAP ###
EMSCO_LDAP_BASE_DN='dc=smals-mvm,dc=be'
EMSCO_LDAP_SEARCH_DN='cn=ldap,ou=Service Accounts,ou=Accounts,ou=563,ou=560,ou=500,ou=Data Management,dc=smals-mvm,dc=be'
EMSCO_LDAP_SEARCH_PASSWORD='Query_smals'
EMSCO_LDAP_DEFAULT_ROLES='["ROLE_USER"]'
EMSCO_LDAP_EXTRA_FIELDS='["mail","displayName","givenName","sn"]'
EMSCO_LDAP_EMAIL_FIELD='mail'
EMSCO_LDAP_DISPLAY_NAME_FIELD='displayName'
EMSCO_LDAP_DN_STRING='{username}@smals-mvm'
EMSCO_LDAP_GIVEN_NAME_FIELD='givenName'
EMSCO_LDAP_LAST_NAME_FIELD='sn'
EMSCO_LDAP_FILTER='({uid_key}={username})'
EMSCO_LDAP_UID_KEY='sAMAccountName'
###< EMSCoreBundle/LDAP ###

###> EMSClientHelperBundle ###
EMSCH_LOCALES='["nl","fr","de","en"]'
EMSCH_ROUTE_TYPE='ems_standard_route'
EMSCH_TRANSLATION_TYPE='ems_standard_label'
EMSCH_TEMPLATE_EMS_LINK='@EMSCH/ems_standard_template/ems/{type}.ems_link.twig'
EMSCH_TEMPLATES='{"ems_standard_template":{"name":"template_name","code":"template_body"},"ems_standard_template_ems":{"name":"template_name","code":"template_body"}}'
EMSCH_ENVS='{"preview":{"alias":"${APP_INSTANCE_ID}preview","default": true,"router":false}}'
###< EMSClientHelperBundle ###

###> EMSFormBundle ###
EMSF_TYPE=ems_standard_form
EMSF_LOAD_FROMJSON='true'
###< EMSFormBundle ###

###> EMSSubmissonBundle ###
EMSS_CONNECTIONS='${APP_FORMS_CONNECTIONS}'
EMSS_DEFAULT_TIMEOUT='10'
###< EMSSubmissonBundle ###
#EOF
