# Adresse de contact du compte Let's Encrypt (facultative).
# Laisser vide pour créer le compte ACME sans adresse de contact.
ACME_EMAIL=

# Mot de passe initial obligatoire de l'utilisateur Elasticsearch "elastic".
# Choisir une valeur forte dans .env avant le premier démarrage.
ELASTIC_PASSWORD=

# Mémoire maximale du conteneur ; le tas JVM est dimensionné automatiquement.
ELASTICSEARCH_MEMORY_LIMIT=2g

# Base et utilisateur créés au premier démarrage de PostgreSQL 17.
POSTGRES_DB=globalview
POSTGRES_USER=globalview

# Mot de passe initial obligatoire ; choisir une valeur forte dans .env.
POSTGRES_PASSWORD=

# Clés de signature JWT Mercure obligatoires (HS256).
# Générer chaque clé séparément avec : openssl rand -base64 32
# Utiliser les mêmes clés dans l'application qui signe les JWT correspondants.
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=

# Variable elasticMS
EMS_VERSION=7.3.10
INSTANCE_ID=globalview_
EMS_ELASTICSEARCH_HOSTS={"hosts":["http://elasticsearch:9200"],"username":"elastic","password":"ELASTIC_PASSWORD"}
EMSF_AUTHKEY=
EMS_ADMIN_STORAGES='[{"type":"s3","bucket":"bucket","credentials":{"version":"2006-03-01","region":"eu-central-1","credentials":{"key":"username","secret":"password"},"use_path_style_endpoint":true}}]'