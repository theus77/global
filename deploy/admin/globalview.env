NGINX_SERVER_NAME='~^(global-admin-ems7\.theus\.be)$'

EMS_CACHE_PREFIX='globalview_admin_'
EMS_CACHE=redis

EMSCO_INSTANCE_ID='globalview_'
EMSCO_NAME='<i class="ems-icon-ball"></i> <b>Global View</b>'
EMSCO_SHORTNAME='<i class="ems-icon-ball"></i><span class="sr-only">Global View</span>'
EMSCO_DATE_TIME_FORMAT='j/m/Y \a\t G:i'
EMSCO_DATEPICKER_FORMAT='dd/mm/yyyy'
EMSCO_DATEPICKER_WEEKSTART='1'
EMSCO_DATEPICKER_DAYSOFWEEK_HIGHLIGHTED='[0, 6]'
EMSCO_ALLOW_USER_REGISTRATION='false'
EMSCO_THEME_COLOR='blue'
EMSCO_GROUP_FEATURE='true'
EMSCO_PRE_GENERATED_OUUIDS='true'
#EMSCO_TEMPLATE_NAMESPACE='EMSAdminUI/bootstrap5'

EMSCH_TEMPLATES='{"ems_standard_template":{"name":"template_name","code":"template_body"},"ems_standard_template_ems":{"name":"template_name","code":"template_body"}}'
EMSCH_ENV='default'
EMSCH_ENVS='{"default":{"alias":"globalview_ma_preview","router": false, "default": true}}'
EMSCH_LOCALES='["fr"]'
#EMSCH_LOCAL_PATH='../demo/skeleton'
#EMSCH_ASSET_LOCAL_FOLDER='bundles/demo'
EMSCH_TEMPLATE_EMS_LINK='@EMSCH/ems_standard_template/ems/{type}.ems_link.twig'
EMSCH_TEMPLATE_ERROR='@EMSCH/ems_standard_template/error/error{code}.html.twig'
EMSCH_ROUTE_TYPE='ems_standard_route'
EMSCH_TRANSLATION_TYPE='ems_standard_label'

EMSF_LOAD_FROMJSON=true
