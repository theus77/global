### Apache ###
NGINX_SERVER_NAME='~^(global-web-ems7\.theus\.be)$'
NGINX_BUNDLES_LOCATION_CACHE_CONTROL='immutable, max-age=63072000, public'
NGINX_X_FRAME_OPTIONS=SAMEORIGIN
NGINX_REFERRER_POLICY='no-referrer-when-downgrade'
NGINX_CONTENT_SECURITY_POLICY="script-src 'self' https://maps.googleapis.com"
#NGINX_ACCESS_CONTROL_ALLOW_ORIGIN='https://elasticms.fgov.be'
NGINX_PERMISSIONS_POLICY='accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()'
NGINX_STRICT_TRANSPORT_SECURITY='max-age=31536000; includeSubDomains'
#NGINX_ENVIRONMENTS='[{"alias":"/live/demo","env":"live"},{"alias":"/demo","env":"live"}]'
#NGINX_CUSTOM_ASSETS_RC='/(bundles|skeleton)'

### Symfony ###
APP_SECRET='644e6aeb0a7baca45612529f439d3b78'
EMSCH_LOCALES='["fr"]'
DEFAULT_LOCAL='fr'
MAILER_URL='smtp://mailserver.theus.be:1025'

PUB_ENV='globalview_ma_live_web'

### EMS Common ###
EMS_CACHE_PREFIX='globalview_preview_'

### EMS Client Helper ###
EMSCH_BIND_LOCALE=false
EMSCH_ENV='globalview_ma_live_web'
EMSCH_TRANSLATION_TYPE=''
EMSCH_ENVS='{"live":{"regex":"/.*/","alias":"globalview_ma_live_web","request":{"_locale":"fr"}}}'
EMSCH_TEMPLATES='{"ems_standard_template":{"name":"template_name","code":"template_body"},"ems_standard_template_ems":{"name":"template_name","code":"template_body"}}'
EMSCH_TEMPLATE_EMS_LINK='@EMSCH/ems_standard_template/ems/{type}.ems_link.twig'
EMSCH_TEMPLATE_ERROR='@EMSCH/ems_standard_template/error/error{code}.html.twig'
EMSCH_ROUTE_TYPE='ems_standard_route'
EMSCH_TRANSLATION_TYPE='ems_standard_label'

###> EMSFormBundle ###
EMSF_TYPE=ems_standard_form
EMSF_LOAD_FROMJSON='true'

#EOF
