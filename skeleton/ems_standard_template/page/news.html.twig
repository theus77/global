{%- extends "@EMSCH/ems_standard_template/page/base.html.twig" -%}

{% import '@EMSCH/ems_standard_template/macros/wysiwyg.twig' as wysiwyg %}

{% block title %}
    {%- trans_default_domain trans_default_domain -%}
    {{- 'page.news.title_prefix'|trans }} {{ parent() -}}
{% endblock title %}

{%- block body -%}
    {%- set languageUrls = emschLocales
        |filter(l => source.(l).show|default == true and source.(l).slug is defined)
        |reduce((carry, l) => carry|default([])|merge({
            (l): path('news', { '_locale': l, 'slug': source.(l).slug })
        }))
    -%}
    {{ parent() }}
{%- endblock body -%}

{%- block content -%}
    {% trans_default_domain trans_default_domain %}

    {%- set flightTitle = source.(locale).title|default('') -%}
    {%- set flightBody = source.(locale).body|default('') -%}
    {%- set flightImage = source.image_news|default(false) -%}
    {%- set flightForm = 'ems_standard_form:9dcc7518-fe47-42f5-b579-7fababf08a5c' -%}

    <article class="section next-flight-detail">
        <div class="container">
            <header class="section-heading pt-0">
                <h1 id="next-flight-title" {{ emsch_admin_menu(emsLink|format) }}>
                    {{ flightTitle }}
                </h1>
            </header>

            <div class="row g-4 g-lg-5 align-items-start">
                <div class="col-lg-7">
                    <section class="next-flight-card" aria-labelledby="next-flight-title">
                        {%- if flightImage -%}
                            <figure class="next-flight-map mb-4">
                                <img src="{{ ems_asset_path(flightImage, {
                                    _config_type: 'image',
                                    _width: 176,
                                    _height: 176,
                                    _quality: 80,
                                    _author: 'Simon Schmitt',
                                    _copyright: '© GlobalView.be',
                                    _image_format:'webp',
                                }) }}"
                                     alt=""
                                     class="img-fluid"
                                     loading="lazy" width="176" height="176">
                            </figure>
                        {%- endif -%}

                        {%- if flightBody -%}
                            <div class="next-flight-body wysiwyg">
                                {{ wysiwyg.transform(flightBody|emsch_routing_config(emsch_routing_config), trans_default_domain) }}
                            </div>
                        {%- endif -%}
                    </section>
                </div>

                {%- if flightForm -%}
                    <div class="col-lg-5">
                        <aside class="next-flight-contact"
                               aria-labelledby="next-flight-contact-title">
                            <h2 id="next-flight-contact-title" class="h3">
                                {{ 'flight.contact.title'|trans }}
                            </h2>

                            {%- set form = flightForm|emsch_get -%}
                            {%- set iframeUrl = absolute_url(path('emsf_iframe', { ouuid: form.id, _locale: locale })) -%}

                            <div id="ems-form-next-flight" class="ems-form-custom">
                                <p>{{ 'form.loading'|trans|raw }}</p>
                            </div>

                            <iframe id="ems-form-iframe-next-flight"
                                    src="{{ iframeUrl }}"
                                    style="display:none;"
                                    title="{{ 'form.iframe_title'|trans }}"
                                    data-form-id="ems-form-next-flight"
                                    data-message-id="ems-message-next-flight"
                                    data-default-data="{{ {flight: flightTitle}|json_encode|e('html_attr') }}">
                            </iframe>

                            <div id="ems-message-next-flight"></div>
                        </aside>
                    </div>
                {%- endif -%}
            </div>
        </div>
    </article>
{%- endblock content -%}
