{%- extends '@EMSCH/ems_standard_template/page/block/abstract-block.html.twig' -%}

{%- block row -%}
    {%- trans_default_domain trans_default_domain -%}
    {% set aggregations = emsch_search(['globalview_version'], {
        "size": 0,
        "aggs": {
            "keywords": {
                "nested": {
                    "path": "keywords"
                },
                "aggs": {
                    "keyword_name": {
                        "terms": {
                            "field": "keywords.name_#{app.request.locale}.alpha_order",
                            "order": {
                                "_key": "asc"
                            },
                            "size": 10000
                        },
                        "aggs": {
                            "by_uuid": {
                                "terms": {
                                    "field": "keywords.keyword_id"
                                },
                                "aggs": {
                                    "keyword_to_version": {
                                        "reverse_nested": {},
                                        "aggs": {
                                            "top_uuid_hits": {
                                                "top_hits": {
                                                    "sort": [
                                                        {
                                                            "rating": {
                                                            "order": "desc"
                                                        }
                                                        },
                                                        {
                                                            "date": {
                                                            "order": "desc"
                                                        }
                                                        }
                                                    ],
                                                    "_source": {
                                                        "include": [
                                                            "keywords",
                                                            "stack",
                                                        ]
                                                    },
                                                    "size": 1
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }, 0, 0).aggregations.keywords.keyword_name.buckets|map(v => {
        total: v.doc_count,
        keyword_id:  v.by_uuid.buckets.0.key,
        keyword:  v.by_uuid.buckets.0.keyword_to_version.top_uuid_hits.hits.hits.0._source.keywords|filter(k => k.keyword_id == v.by_uuid.buckets.0.key)|first,
        image:  v.by_uuid.buckets.0.keyword_to_version.top_uuid_hits.hits.hits.0._source.stack|first,
    }) %}

    <div class="row g-4" id="keywords">
        {% for agg in aggregations %}
            <div class="col-md-4">
                <div class="box h-100">
                    <a href="{{ path('search', {_locale: locale, keyword: agg.keyword_id|split(':')|last } ) }}" class="news-list-link btn btn-lg d-flex flex-column justify-content-center w-100 h-100">
                        <h3 class="mt-0">{{- agg.keyword.("name_#{locale}")|default(agg.keyword.name_fr|default('')) -}} </h3>
                        <span class="text-wrapper mt-3">
                            <img src="{{ asset('img/website/loading-square.jpg', 'emsch') }}" data-src="{{ ems_asset_path(agg.image, {
                                _config_type: 'image',
                                _width: 176,
                                _height: 176,
                                _quality: 90,
                                _resize: 'smartCrop',
                                _image_format:'webp',
                                _author: 'Simon Schmitt',
                                _copyright: '© GlobalView.be',
                            }) }}" class="img-fluid rounded-circle lazy" alt="" width="176" height="176">
                        </span>
                        <span class="mt-3 text-white">{{ 'gallery.result.counter'|trans({'%count%': agg.total}) }}</span>
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
{%- endblock row -%}