{%- extends '@EMSCH/ems_standard_template/page/block/abstract-block.html.twig' -%}

{%- block row -%}
    {%- trans_default_domain trans_default_domain -%}
    {% set searchSlideshowNews = emsch_search('ems_standard_news', {
        'size': 10,
        '_source': ['date_news', "#{locale}.title", "#{locale}.slug", "#{locale}.summary", "#{locale}.alt_slideshow", 'image_news_slideshow'],
        'sort': [ { 'date_news': { 'order': 'desc' } } ],
        'query': { 'bool': { 'must': [
            { 'term': { ("#{locale}.show"): { 'value': true } } },
            { 'nested': { 'path': 'image_news_slideshow', 'query': { 'exists': { 'field': 'image_news_slideshow' } } } },
            { 'nested': { 'path': 'dates_news_slideshow', 'query': {
                'bool': { 'must': [
                    { 'range': { 'dates_news_slideshow.from': { 'lte': 'now' } } },
                    { 'range': { 'dates_news_slideshow.to': { 'gte': 'now' } } }
                ] }
            } }}
        ] } }
    })  %}

    {% set newsItems = searchSlideshowNews.hits.hits|reduce((carry, h) => carry|default([])|merge([{
        'emsId': "#{h._source._contenttype}:#{h._id}",
        'date': h._source.date_news,
        'title': h._source.(locale).title,
        'alt': h._source.(locale).alt_slideshow|default(h._source.(locale).title),
        'summary': h._source.(locale).summary|default(''),
        'url': path('news', { 'slug': h._source.(locale).slug }),
        'image': h._source.image_news_slideshow
    }]))  %}

    {%- if newsItems|length > 0 -%}
        <section class="hero border-bottom text-white">
            {{ block('widget') }}
        </section>
    {%- endif -%}
{%- endblock row -%}

{%- block widget -%}
    {%- trans_default_domain trans_default_domain -%}
    {%- set slideShowId = "hero-swiper" -%}
    <div class="swiper-container w-100 h-100" id="{{ slideShowId }}">
        <div class="swiper-wrapper">
            {%- for newsItem in newsItems -%}
                <div class="swiper-slide d-flex align-items-center hero-slide js-spread-link cursor-pointer"
                     style="{{ 'background-image: url(' ~ ems_asset_path(newsItem.image, {
                         _config_type: 'image',
                         _resize: 'smartCrop',
                         _width: 1600,
                         _height: 900,
                     }) ~ ');' }}"
                     data-hero-slider-title="{{ newsItem.title }}"
                     data-hero-slider-url="{{ newsItem.url }}"
                >
                    <div class="hero-visual">
                        <a href="{{ newsItem.url }}" class="text-decoration-none d-block stretched-link" aria-label="{{ newsItem.title }}">
                            <img class="img-fluid" src="{{ ems_asset_path(newsItem.image, {
                                _config_type: 'image',
                                _resize: 'smartCrop',
                                _width: 1600,
                                _height: 900,
                            }) }}" alt="{{ newsItem.alt }}">
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    <div class="hero-box">
        <div class="hero-box__container">
            <div class="hero-description text-white mb-5" data-hero-slider-title-target></div>
            <div>
                <div class="d-flex align-items-center gap-4">
                    {% if newsItems|length > 1 %}
                        <div class="hero-swiper-pagination d-flex"></div>
                    {% endif %}
                    <a class="hero-swiper-play text-white text-decoration-none d-none text-uppercase" aria-label="Play {{'news.slideshow'|trans}}" role="button" href="#"><i class="fas fa-play me-2" aria-hidden="true" role="img"></i> {{'news.slideshow'|trans}}</a>
                    <a class="hero-swiper-pause text-white text-decoration-none text-uppercase" aria-label="Pause {{'news.slideshow'|trans}}" role="button" href="#"><i class="fas fa-pause me-2" aria-hidden="true" role="img"></i> {{'news.slideshow'|trans}}</a>
                </div>
            </div>
        </div>
    </div>
{%- endblock widget -%}
