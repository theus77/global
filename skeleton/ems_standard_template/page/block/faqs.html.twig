{%- extends '@EMSCH/ems_standard_template/page/block/abstract-block.html.twig' -%}

{%- block row -%}
    {%- set faqIds = source.faqs|ems_json_decode|map(item => item.object.faq_link|ems_link.ouuid)|default([]) -%}
    {%- set searchFaqs = emsch_search('ems_standard_faq', {
        'query': {
            'bool': {
                'must': [
                    { 'term': { ("#{locale}.show"): true } },
                    { 'terms': { '_id': faqIds } }
                ]
            }
        }
    }) -%}

    {%- set faqHits = searchFaqs.hits.hits|ems_array_key('_id') -%}
    {%- set faqs = faqIds
        |filter(id => faqHits.(id) is defined and faqHits.(id)._source.(locale).question is defined)
        |map(id => faqHits.(id))
        |reduce((carry, hit) => carry|default([])|merge([{
        'id': hit._source.(locale).question|ems_slug,
        'question': hit._source.(locale).question,
        'answer': hit._source.(locale).answer
    }])) -%}

    {%- if faqs|length > 0 -%}
        <section class="my-5">
            <div class="container">
                <div class="row">
                    <div class="col-lg-9">
                        {{ block('widget') }}
                    </div>
                </div>
            </div>
        </section>
    {%- endif -%}
{%- endblock row -%}

{%- block widget -%}
    {% import '@EMSCH/ems_standard_template/macros/wysiwyg.twig' as wysiwyg %}

    <div class="accordion">
        {%- for faq in faqs -%}
            <div class="accordion-item py-2 pmy-lg-4">
                <h2 class="accordion-header" id="faq-{{ faq.id }}">
                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ faq.id }}" aria-expanded="false" aria-controls="{{ faq.id }}">
                        <span>{{ faq.question }}</span>
                    </button>
                </h2>
                <div id="{{ faq.id }}" class="accordion-collapse collapse" aria-labelledby="faq-{{ faq.id }}">
                    <div class="accordion-body">
                        {{ wysiwyg.transform(faq.answer|emsch_routing_config(emsch_routing_config)) }}
                    </div>
                </div>
            </div>
        {%- endfor -%}
    </div>
{%- endblock widget -%}
