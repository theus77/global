{%- set zoom = app.request.query.get('zoom', '') -%}
{%- if not (zoom matches '/^[0-9]{1,2}$/') or zoom / 1 > 22 -%}
    {%- do emsch_http_error('400', 'Invalid map zoom') -%}
{%- endif -%}
{%- set bounds = {} -%}
{%- for coordinate in ['north', 'south', 'east', 'west'] -%}
    {%- set value = app.request.query.get(coordinate, '') -%}
    {%- set limit = coordinate in ['north', 'south'] ? 90 : 180 -%}
    {%- if not (value matches '/^-?[0-9]+(?:[.][0-9]+)?$/') or value / 1 < -limit or value / 1 > limit -%}
        {%- do emsch_http_error('400', 'Invalid map bounds') -%}
    {%- endif -%}
    {%- set bounds = bounds|merge({(coordinate): value / 1}) -%}
{%- endfor -%}
{%- if bounds.south > bounds.north -%}
    {%- do emsch_http_error('400', 'Invalid map bounds') -%}
{%- endif -%}
{%- set levels = zoom <= 6 ? [1] : (zoom <= 8 ? [2] : (zoom <= 11 ? [16] : [43, 47])) -%}
{%- set composite = {
    size: 200,
    sources: [{place: {terms: {field: 'locations.place_id'}}}],
} -%}
{%- set after = app.request.query.get('after', '') -%}
{%- if after != '' -%}
    {%- if not (after matches '/^globalview_place:[a-zA-Z0-9_-]+$/') -%}
        {%- do emsch_http_error('400', 'Invalid map cursor') -%}
    {%- endif -%}
    {%- set composite = composite|merge({after: {place: after}}) -%}
{%- endif -%}
{%- set result = emsch_search('globalview_version', {
    size: 0,
    query: {bool: {filter: [{geo_bounding_box: {
        location: {
            top_left: {lat: bounds.north, lon: bounds.west},
            bottom_right: {lat: bounds.south, lon: bounds.east},
        },
    }}]}},
    aggs: {
        locations: {
            nested: {path: 'locations'},
            aggs: {
                selected: {
                    filter: {terms: {'locations.level': levels}},
                    aggs: {
                        places: {
                            composite: composite,
                            aggs: {
                                details: {top_hits: {
                                    size: 1,
                                    _source: ['locations.name_fr', 'locations.name_nl', 'locations.name_de', 'locations.name_en'],
                                }},
                                versions: {
                                    reverse_nested: {},
                                    aggs: {
                                        center: {geo_centroid: {field: 'location'}},
                                        preview: {top_hits: {
                                            size: 1,
                                            sort: [{rating: {order: 'desc', missing: '_last'}}, {date: {order: 'desc', missing: '_last'}}],
                                            _source: ['stack', 'label', 'name'],
                                        }},
                                    },
                                },
                            },
                        },
                    },
                },
            },
        },
    },
}, 0, 0) -%}
{%- set places = result.aggregations.locations.selected.places -%}
{%- set markers = [] -%}
{%- for bucket in places.buckets -%}
    {%- set details = bucket.details.hits.hits|first._source|default({}) -%}
    {%- set version = bucket.versions.preview.hits.hits|first._source|default({}) -%}
    {%- set center = bucket.versions.center.location|default(null) -%}
    {%- set image = version.stack|default([])|first|default(null) -%}
    {%- set label = attribute(details, 'name_' ~ app.request.locale)|default(details.name_fr|default(details.name_en|default(bucket.key.place))) -%}
    {%- if center and bucket.versions.doc_count > 0 -%}
        {%- set markers = markers|merge([{
            id: bucket.key.place|split(':')|last,
            label: label,
            count: bucket.versions.doc_count,
            lat: center.lat,
            lng: center.lon,
            image: image ? ems_asset_path(image, {
                _config_type: 'image', _image_format: 'webp', _width: 360, _height: 240, _resize: 'smartCrop', _quality: 85,
            }) : asset('img/website/missing.' ~ app.request.locale ~ '.jpg', 'emsch'),
            imageLabel: version.label|default(version.name|default(label)),
            url: path('search', {_locale: app.request.locale, location: bucket.key.place|split(':')|last}),
        }]) -%}
    {%- endif -%}
{%- endfor -%}
{{- {markers: markers, levels: levels, after: places.after_key.place|default(null)}|json_encode|raw -}}
