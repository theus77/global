{%- extends "@EMSCH/ems_standard_template/page/base.html.twig" -%}
{%- trans_default_domain trans_default_domain -%}

{%- block request %}
    {%- set galleryTemplate = '@EMSCH/ems_standard_template/page/include/gallery.twig' -%}
    {%- import galleryTemplate as macro -%}
    {%- set search = macro.search({
        'locale': locale,
        'domain': trans_default_domain
    })|ems_json_decode -%}
    {{ parent() }}
{%- endblock request -%}

{%- block title -%}
     {{ search.title }}
{%- endblock title -%}

{%- block main -%}
    {% if search.total > 0 %}
        {{ block('gallery') }}
    {% else %}
        {{ block('not_result') }}
    {% endif %}
{%- endblock main -%}

{% block not_result %}
    <div class="row">
        <div class="col-12">
            <div class="simple-box2">
                <div class="content">
                    <h1>{{ block('title') }}</h1>
                    {{ block('search_form') }}
                </div>
            </div>
        </div>
    </div>
{%- endblock not_result -%}

{% block gallery %}
    <div id="galerie-filmstrip" class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <h1>
                    {{ block('title') }}
                    <span class="badge">{{ 'gallery.result.counter'|trans({'%count%': search.total}) }}</span>
                </h1>
            </div>
        </div>
        <div class="row" id="galerie-thumb-bro">
            <div class="col-md-12 galerie-thumb">
                 <div class="galerie-thumb-scroll" id="thumb-scroll-container" tabindex="0">
                    {% for count in 0..(search.total-1) %}
                        <a href="#" class="{{ html_classes('gallery-thumbnail', { 'active': loop.first }) }}" data-index="{{ loop.index0 }}">
                            {% set previewUrl = path('gallery_image_preview', search.query|merge({index: loop.index0})) %}
                            {% if loop.index0 >= search.from and search.results|length > (loop.index0 - search.from) %}
                                {% set hit = search.results[loop.index0 - search.from] %}
                                {% set attrs = {
                                    src: previewUrl,
                                    alt: hit.label|default,
                                    title: hit.label|default,
                                }|filter(v => v) %}
                            {% else %}
                                {% set attrs = {
                                    src: asset('img/website/loading.jpg', 'emsch'),
                                    'data-src': previewUrl,
                                } %}
                            {% endif %}
                            <img id="thumb-{{ loop.index0 }}" {% for attr, value in attrs %} {{ attr }}="{{ value|e('html_attr') }}"{% endfor %} data-index="{{ loop.index0 }}" class="lazy-in-scroll lazy" width="300" height="200">
                        </a>
                    {% endfor %}
                </div>
            </div>
        </div>

        <p class="gallery-load-error alert alert-danger mx-3" role="alert" hidden>{{ 'gallery.load_error'|trans }}</p>
        <div class="carousel slide" id="carousel" data-bs-interval="false"
             data-count="{{ search.total }}" data-current="0"
             data-slide-url="{{ path('gallery_slide', {_locale: locale}) }}"
             data-query="{{ search.query|json_encode|e('html_attr') }}">
            <div class="carousel-inner" role="listbox">
                {% set versionDocument = ('globalview_version:' ~ search.results[0].id)|emsch_get %}
                {% include '@EMSCH/ems_standard_template/page/include/gallery-slide.html.twig' with {
                    version: versionDocument.raw._source,
                    index: 0,
                    active: true,
                } %}
            </div>
        </div>
    </div>
{% endblock gallery %}
