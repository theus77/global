{%- block emailEndpoint -%}
    {{- "simon@globalview.be" -}}
{%- endblock emailEndpoint -%}

{%- block emailMessage -%}
    {% set subject = 'Demande de contact' %}
    {% if data.flight|default %}
        {% set subject = "A propos du vol #{data.flight}" %}
    {% endif %}
    {% set body %}
        ----------- REQUEST INFORMATION -----------
        Subject: {{ subject }}

        Message:
        {{ data.message|raw }}

        ----------- CONTACT -----------
        Lastname: {{ data.name|raw }}
        Email: {{ data.email|raw }}
        {% if data.project_phone|default %}Phone: {{ data.phone|raw }}
        {% endif %}
    {% endset %}

    {%- set mail = {
        'from': "no-reply@ems_standard.be",
        'subject': subject,
        'body': body|nl2br
    } -%}

    {{- mail|json_encode|raw -}}
{%- endblock emailMessage -%}

