{%- extends "@EMSCH/ems_standard_template/base/base_structure.twig" -%}

{%- trans_default_domain trans_default_domain -%}

{%- block body -%}
    <a id="skip-to-content" class="visually-hidden-focusable" href="#wrapper">{{ 'aria.skip_to_content'|trans }}</a>
    <div id="preloader"></div>
    <div id="bg_pattern"></div>
    {{ block('backtotop') }}

    {{ block('alerts') }}
    {{ block('header') }}
    {{ block('main') }}
    {{ block('cookies') }}
    {{ block('footer') }}
    {{ block('modal_search') -}}
{%- endblock body -%}

{% block bodyAttributes -%}class="slider-background default"{%- endblock bodyAttributes -%}

{%- block alerts -%}
    {%- if alerts|default([])|length > 0 -%}
        <div class="alerts" id="alerts">
            {%- for alert in alerts|default([]) -%}
                <div class="alert alert-danger mb-0 {{ not loop.first ? 'border-top border-danger-subtle' }}" role="alert">
                    <div class="container-lg">
                        {% if alerts|length > 1 %}
                            <p class="d-flex align-items-center gap-3">
                                <span class="fa-solid fa-circle-info" aria-hidden="true" role="img"></span>
                                <a class="text-decoration-none fw-medium" data-bs-toggle="collapse" href="#{{ alert.id }}" role="button" aria-expanded="false" aria-controls="{{ alert.id }}">
                                    {{ alert.title }}
                                </a>
                            </p>
                            <div class="collapse" id="{{ alert.id }}">
                                {{ alert.content|emsch_routing_config(emsch_routing_config) }}
                            </div>
                        {% else %}
                            <div class="alert-content">
                                <span class="fa-solid fa-circle-info me-2" aria-hidden="true" role="img"></span><span class="fw-medium">{{ alert.title }} &dash; </span>
                                {{ alert.content|emsch_routing_config(emsch_routing_config) }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock alerts -%}

{%- block header -%}
    <header class="masthead header header--fixed">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-inverse navbar-fixed-top fixed-top navbar-scroll" {% if title_prefix|default(false) %}style="background-color: red;"{% endif %}>
            <div class="container">
                <a href="{{ path('homepage') }}" class="navbar-brand">
                    <img src="{{ asset('img/logo/logo.png', 'emsch') }}" alt="{{ 'navbar.back_to_homepage'|trans }}">
                </a>

                <button type="button"
                        class="navbar-toggler"
                        data-bs-toggle="collapse"
                        data-bs-target="#collapse-navbar"
                        aria-controls="collapse-navbar"
                        aria-expanded="false"
                        aria-label="{{ 'aria.toggle_navigation'|trans }}">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="collapse-navbar">
                    {{ block('header_structure') }}
                    <form action="{{ path('search') }}" class="navbar-form d-lg-none mt-3" method="GET">
                        <div class="input-group">
                            <input type="text"
                                   class="form-control QuickSearchInput"
                                   placeholder="{{ 'navbar.search.placeholder'|trans }}"
                                   aria-label="{{ 'navbar.search.title'|trans }}"
                                   name="q"
                                   data-search-url="{{ path('search', { _format: 'json' }) }}">
                            <button type="submit" class="btn btn-outline-light">
                                <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
                                <span class="visually-hidden">{{ 'navbar.search.title'|trans }}</span>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="search-form" id="navbar-search-form">
                    <form action="{{ path('search') }}" class="navbar-form" method="GET">
                        <div class="form-group search-toggle">
                            <input type="text"
                                   class="form-control QuickSearchInput"
                                   placeholder="{{ 'navbar.search.placeholder'|trans }}"
                                   aria-label="{{ 'navbar.search.title'|trans }}"
                                   name="q"
                                   data-search-url="{{ path('search', { _format: 'json' }) }}">
                        </div>
                        <button type="submit" class="btn btn-default">
                            <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
                            <span class="visually-hidden">{{ 'navbar.search.title'|trans }}</span>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>
{%- endblock header -%}

{%- block search_form -%}
    <form action="{{ path('search') }}" method="GET">
        <div class="input-group">
            <input type="text" name="q" class="form-control border-end-0" placeholder="{{ 'search.placeholder'|trans }}" aria-label="{{ 'search.action'|trans }}">
            <button class="btn rounded-end-pill border-start-0" type="submit">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <span class="sr-only">{{ 'search.action'|trans }}</span>
            </button>
        </div>
    </form>
{%- endblock search_form -%}

{%- block header_structure -%}
    {%- set headerStructure = structure.getItemById('menu') -%}
    {%- set headerItems = headerStructure.children|filter(c => c.object.(locale) is defined) -%}
    {%- if headerStructure and headerItems|length > 0 -%}
        <ul class="navbar-nav ms-lg-auto">
            {%- for item in headerItems -%}
                {%- if item.type == 'page' -%}
                    <li class="nav-item">
                        <a href="{{ pathStructure.(item.id) }}"
                           class="{{ html_classes('nav-link', { 'active': activeItem is defined and item.id == activeItem.id }) }}"
                           aria-current="page">
                            {{ item.object.(locale).label }}
                        </a>
                    </li>
                {%- elseif item.type == 'link' -%}
                    {% if item.object.(locale) and item.object.(locale).link and item.object.(locale).label %}
                        <li class="nav-item">
                            <a href="{{ item.object.(locale).link|replace(replacements) }}"
                               class="nav-link">
                                {{ item.object.(locale).label }}
                            </a>
                        </li>
                    {% endif %}
                {%- elseif item.type == 'folder' and item.children|filter(c => c.object.(locale) is defined)|length > 0 -%}
                    {%- set folderId = "nav-#{item.label|ems_slug}" -%}
                    <li class="nav-item dropdown">
                        <a href="#"
                           class="{{ html_classes('nav-link dropdown-toggle', { 'active': activeItem is defined and item in activeItem.path }) }}"
                           id="{{ folderId }}"
                           role="button"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            {{ item.object.(locale).label }}
                        </a>
                        <div class="dropdown-menu" aria-labelledby="{{ folderId }}">
                            <ul class="d-flex flex-column flex-lg-row list-unstyled container-lg justify-content-start align-items-stretch flex-wrap">
                                {%- for folderItem in item.children|filter(c => c.object.(locale) is defined) -%}
                                    <li class="{{ html_classes('dropdown-item', { 'active': activeItem is defined and folderItem.id in activeItem.id, 'mb-3 mb-lg-0': loop.last }) }}">
                                        {%- if folderItem.type == 'page' -%}
                                            <a href="{{ pathStructure.(folderItem.id) }}" class="d-inline-block">
                                                {{- folderItem.object.(locale).label -}}
                                            </a>
                                        {%- elseif folderItem.type == 'link' and folderItem.object.(locale).link and folderItem.object.(locale).label %}
                                            <a href="{{ folderItem.object.(locale).link|replace(replacements) }}" class="d-inline-block">
                                                {{- folderItem.object.(locale).label -}}
                                            </a>
                                        {%- endif -%}
                                    </li>
                                {%- endfor -%}
                            </ul>
                        </div>
                    </li>
                {%- endif -%}
            {%- endfor -%}
            <li class="nav-item d-none d-lg-block">
                <button type="button" class="nav-link search_button border-0 bg-transparent" aria-controls="navbar-search-form" aria-expanded="false" aria-label="{{ 'navbar.search.title'|trans }}">
                    <span class="fa-solid fa-magnifying-glass" aria-hidden="true"></span>
                </button>
            </li>
        </ul>
    {%- endif -%}
{%- endblock header_structure -%}

{%- block main -%}
    <main class="" id="wrapper">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="simple-box2">
                        <div class="content">
                            {%- block content -%}{%- endblock content -%}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
{%- endblock main -%}

{%- block breadcrumb -%}
    {%- if breadcrumb is defined and breadcrumb|length > 0 -%}
        <div class="container mb-5">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="{{ path('homepage') }}">{{ 'key.home'|trans }}</a>
                    </li>
                    {%- for b in breadcrumb|filter(item => item.label is not null) -%}
                        {%- if not loop.last -%}
                            <li class="breadcrumb-item">
                                {%- if b.url is not null -%}
                                    <a href="{{ b.url }}">{{ b.label }}</a>
                                {%- else -%}
                                    {{ b.label }}
                                {%- endif -%}
                            </li>
                        {%- else -%}
                            <li class="breadcrumb-item active" aria-current="page">{{ b.label }}</li>
                        {%- endif -%}
                    {%- endfor -%}
                </ol>
            </nav>
        </div>
    {%- endif -%}
{%- endblock breadcrumb -%}

{%- block backtotop -%}
    <a href="#wrapper" class="scrollToTop" title="{{ 'back2top.label'|trans }}" aria-label="{{ 'back2top.label'|trans }}"><i class="fa-solid fa-angle-up fa-2x" aria-hidden="true"></i></a>
{%- endblock backtotop -%}

{%- block cookies -%}
    {%- trans_default_domain trans_default_domain -%}
    {%- set cookiePage = 'ems://object:ems_standard_page:c2b06737-a704-41c3-8d6a-8a23ff7a7e7c'|emsch_routing_config(emsch_routing_config) -%}
    <div id="cookieBanner" class="bg-dark text-white fixed-bottom" style="display:none;">
        <div class="container-lg py-4">
            <div class="d-flex flex-column flex-lg-row align-items-center">
                <p class="mb-3 mb-lg-0">{{ 'cookies_banner.intro'|trans }}</p>
                <div class="d-flex flex-column mx-2 flex-lg-row ms-0 ms-lg-auto align-items-center">
                    <a class="btn btn-outline-light me-lg-3" href="{{ cookiePage }}">{{ 'cookies_banner.more_info'|trans }} <i class="fa-solid fa-circle-info ms-1"></i></a>
                    <button id="agreement" class="btn btn-outline-light mt-2 mt-lg-0" href="#">{{ 'cookies_banner.accept'|trans }} <i class="fa-solid fa-circle-check ms-1"></i></button>
                </div>
            </div>
        </div>
    </div>
{%- endblock cookies -%}

{%- block footer -%}
    <footer id="footer">
        <div class="container">
            <ul class="list-inline">
                <li class="list-inline-item">
                    <a href="tel:+32472800900"><i class="fa fa-phone"></i> +32/472.800.900</a>
                </li>
                <li class="list-inline-item">
                    <a href="https://www.facebook.com/globalview.be"><i class="fab fa-facebook-f"></i> {{ 'footer.follow_us'|trans }}</a>
                </li>
                <li class="list-inline-item">
                    <a href="mailto:simon@globalview.be"><i class="far fa-envelope"></i> simon@globalview.be</a>
                </li>
                {{ block('footer_structure') }}
            </ul>
        </div>
    </footer>
{%- endblock footer -%}

{%- block footer_structure -%}
    {%- set footerStructure = structure.getItemById('footer') -%}
    {%- set footerItems = footerStructure.children|filter(c => c.object.(locale) is defined)|default([]) -%}
    {%- for item in footerItems -%}
        {%- if item.type == 'page' -%}
            {% set icon = 'cookie' in item.object.(locale).label|lower ? 'fas fa-cookie' : 'fa fa-camera'%}
            <li class="list-inline-item">
                <a href="{{ pathStructure.(item.id) }}"><i class="{{ icon }}"></i> {{ item.object.(locale).label }}</a>
            </li>
        {%- endif -%}
    {%- endfor -%}
{%- endblock footer_structure -%}

{%- block modal_search -%}
    <div class="modal fade" id="searchModal" tabindex="-1" data-bs-backdrop="false" aria-hidden="true" style="display: none;">
        <div class="modal-dialog m-0">
            <div class="modal-content bg-primary rounded-0 border-0">
                <div class="modal-header border-0">
                    <div class="container-xl">
                        <div class="d-flex align-items-center justify-content-between">
                            <img src="{{ asset("img/logo/logo-white-#{locale}.svg", 'emsch') }}" alt="{{ 'app.title'|trans }}" height="50">
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                    </div>
                </div>
                <div class="modal-body d-flex align-items-center">
                    <div class="container-xl">
                        <div class="row">
                            <div class="col-lg-8 offset-lg-2">
                                <div class="search-bar">
                                    {{ block('search_form') }}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{%- endblock modal_search -%}
