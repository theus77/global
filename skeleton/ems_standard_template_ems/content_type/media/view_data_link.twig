{# @var view \EMS\CoreBundle\Entity\View #}
{# @var contentType \EMS\CoreBundle\Entity\ContentType #}
{# @var environment \EMS\CoreBundle\Entity\Environment #}
{# @var dataLinks \EMS\CoreBundle\Core\Document\DataLinks #}

{%- block template -%}
    {%- set searchValue = dataLinks.pattern -%}

    {%- set locales = emschLocales -%}
    {%- set userLanguage = app.user.language -%}
    {%- if userLanguage in locales -%}
        {%- set locales = [userLanguage]|merge(locales|filter(v => v != userLanguage)) -%}
    {%- endif -%}

    {%- set must = [
        { "term": { "_contenttype": {"value": (contentType.name )} } },
        { "nested": { "path": "media_file", "query": { "exists": { "field": "media_file"} }  } }
    ] -%}

    {%- if searchValue|length > 0 -%}
        {% set must = must|merge([ {
            "bool": {
                "minimum_should_match": 1,
                "should": [
                    { "query_string": { "default_field": "media_path", "query": (searchValue) } },
                    { "wildcard": { "media_path": { "value": "*#{searchValue}*" } } },
                    { "match": { "media_path": (searchValue) } },
                    {
                        "nested": {
                            "path": "media_file",
                            "query": {
                                "bool": {
                                    "minimum_should_match": 1,
                                    "should": [
                                        { "query_string": { "default_field": "media_file.filename", "query": (searchValue) } },
                                        { "wildcard": { "media_file.filename": { "value": "*#{searchValue}*" } } },
                                        { "match": { "media_file.filename": (searchValue) } }
                                    ]
                                }
                            }
                        }
                    }
                ]
            }
        } ]) %}
    {%- endif -%}

    {%- set search = {
        "index": environment.alias,
        "size": 500,
        "body": {
            "_source": "media_path",
            "query": { "bool": { "must": must } }
        }
    }|emsco_search_query -%}

    {%- for hit in search.hits.hits -%}
        {%- do dataLinks.add("#{contentType.name}:#{hit._id}", hit._source.media_path) -%}
    {%- endfor -%}
{%- endblock template -%}
