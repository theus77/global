{%- block show_fr -%}
    {% set showLocale = 'fr' %}
    {{ block('show') }}
{%- endblock show_fr -%}

{%- block show_nl -%}
    {% set showLocale = 'nl' %}
    {{ block('show') }}
{%- endblock show_nl -%}

{%- block show_de -%}
    {%- set showLocale = 'de' -%}
    {{ block('show') }}
{%- endblock show_de -%}

{%- block show_en -%}
    {%- set showLocale = 'en' -%}
    {{ block('show') }}
{%- endblock show_en -%}

{%- block show -%}
    {%- set config = 'config'|emsco_i18n('en')|ems_json_decode -%}
    {%- if source.(showLocale).show|default(false) and source.(showLocale).slug is defined -%}
        {%- set url = [
            "/channel/#{environment.name}",
            showLocale,
            config.prefix.news.(showLocale)|default('news'),
            source.(showLocale).slug
        ]|join('/') -%}
        <a href='{{- url -}}' target='_blank'>
            <i class='fa fa-eye'></i>&nbsp;{{ "Show #{showLocale|upper}" }}
        </a>
    {%- endif -%}
{%- endblock show -%}