{%- block body -%}
    {{ component('media_library', {
        'id': 'ems-standard-media-lib',
        'contentTypeName': 'ems_standard_media',
        'template': '@EMSCH/ems_standard_template_ems/dashboard/media/template.twig',
        'searchType': 'prefix',
        'context': {
            'showRevision': dashboard.definition == null and is_granted('ROLE_ADMIN')
        },
        "sort": [
            { "id": "name", "field": "media_path.alpha_order", "defaultOrder": "asc" },
            { "id": "type", "field": "media_file.mimetype", "parent_field": "media_file" },
            { "id": "user", "field": "_finalized_by" },
            { "id": "created", "field": "date_creation" },
            { "id": "size", "field": "media_file.filesize", "parent_field": "media_file" }
        ]
    }) }}
{%- endblock body -%}

{%- block footer -%}{%- endblock footer -%}

{%- block header -%}
    <style>
        div.media-lib .media-nav-bar a { text-decoration: none; }
    </style>
{%- endblock header -%}
