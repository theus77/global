{%- extends '@EMSCore/components/media_library/template.twig' -%}

{%- block media_lib_header -%}
    <div class="media-lib-container">
        <div class="btn-group">
            {%- if mediaFolder is defined and mediaFile is not defined and selectionFiles == 0 -%}
                {{- template.block('media_lib_button_folder_rename', _context)|raw -}}
                {{- template.block('media_lib_button_folder_move', _context)|raw -}}
                {{- template.block('media_lib_button_folder_delete', _context)|raw -}}
            {%- endif -%}
        </div>

        <div class="btn-group">
            {{- template.block('media_lib_button_folder_add', _context)|raw -}}
            {{- template.block('media_lib_button_upload', _context)|raw -}}
        </div>

        {%- if mediaFile is defined -%}
            <div class="btn-group">
                {{- template.block('media_lib_button_file_view', _context)|raw -}}
                {{- template.block('file_download_file', _context)|raw -}}
            </div>
            <div class="btn-group">
                {{- template.block('button_revision', _context)|raw -}}
                {{- template.block('media_lib_button_file_rename', _context)|raw -}}
                {{- template.block('media_lib_button_files_move', _context)|raw -}}
                {{- template.block('media_lib_button_file_delete', _context)|raw -}}
            </div>
        {%- elseif selectionFiles > 0 -%}
            <div class="btn-group">
                {{- template.block('media_lib_button_files_move', _context)|raw -}}
                {{- template.block('media_lib_button_files_delete', _context)|raw -}}
            </div>
        {%- endif -%}
    </div>
    <div class="media-lib-container">
        {{- template.block('media_lib_search_box', _context)|raw -}}
    </div>
{%- endblock media_lib_header -%}

{%- block media_lib_file_header -%}
    <div data-sort-id="name" style="flex: 4">Name</div>
    <div data-sort-id="type" style="flex: 4">Type</div>
    <div data-sort-id="user" style="flex: 4">Author</div>
    <div data-sort-id="created" style="flex: 2">Creation</div>
    <div data-sort-id="size" class="text-right">Size</div>
{%- endblock media_lib_file_header -%}

{%- block media_lib_file -%}
    <div style="flex: 4">
        <a class="btn-file-view" href="{{- mediaFile.urlView -}}" data-ems-id="{{- mediaFile.emsId -}}" data-id="{{- mediaFile.id -}}">
            {{ mediaFile.folder[folder.path|default('')|length + 1:] }}{{- mediaFile.name -}}
        </a>
    </div>
    <div style="flex: 4">{{- mediaFile.file.mimetype|trans({}, 'emsco-mimetypes') -}}</div>
    <div style="flex: 4">{{- mediaFile.document.getValue('_finalized_by')|emsco_display_name -}}</div>
    <div style="flex: 2">{{ mediaFile.document.getValue('date_creation')|date(date_time_format) }}</div>
    <div class="text-right">{{- mediaFile.file.filesize|default(0)|ems_format_bytes -}}</div>
{%- endblock media_lib_file -%}

{%- block media_lib_button_upload -%}
    {%- if mediaFolder is defined and mediaFolder.path == '/Manuals' -%}
        {%- if is_granted('ROLE_WEBMASTER') -%}{{ parent() }}{%- endif -%}
    {%- else -%}
        {{ parent() }}
    {%- endif -%}
{%- endblock media_lib_button_upload -%}

{%- block media_lib_button_folder_add -%}
    {%- if mediaFolder is not defined or mediaFolder.path != '/Manuals' -%}
        {%- if is_granted('ROLE_PUBLISHER') -%}{{ parent() }}{%- endif -%}
    {%- endif -%}
{%- endblock media_lib_button_folder_add -%}

{%- block media_lib_button_folder_delete -%}
    {%- if mediaFolder is defined and mediaFolder.path == '/Manuals' -%}
        {%- if is_granted('ROLE_WEBMASTER') -%}{{ parent() }}{%- endif -%}
    {%- else -%}
        {%- if is_granted('ROLE_PUBLISHER') -%}{{ parent() }}{%- endif -%}
    {%- endif -%}
{%- endblock media_lib_button_folder_delete -%}

{%- block media_lib_button_folder_rename -%}
    {%- if mediaFolder is defined and mediaFolder.path == '/Manuals' -%}
        {%- if is_granted('ROLE_WEBMASTER') -%}{{ parent() }}{%- endif -%}
    {%- else -%}
        {%- if is_granted('ROLE_PUBLISHER') -%}{{ parent() }}{%- endif -%}
    {%- endif -%}
{%- endblock media_lib_button_folder_rename -%}

{%- block media_lib_button_file_delete -%}
    {% trans_default_domain 'emsco-component' %}
    {%- if mediaFolder is defined and mediaFolder.path != '/Manuals' or is_granted('ROLE_WEBMASTER') -%}
        <button class="btn btn-sm btn-default btn-file-delete" data-id="{{- mediaFile.id -}}">
            <i class="fa fa-trash" aria-hidden="true"></i> {{- buttonLabel|default('media_library.file.delete.title'|trans) -}}
        </button>
    {%- endif -%}
{%- endblock media_lib_button_file_delete -%}

{%- block media_lib_button_file_rename -%}
    {% trans_default_domain 'emsco-component' %}
    {%- if mediaFolder is defined and mediaFolder.path != '/Manuals' or is_granted('ROLE_WEBMASTER') -%}
    <button class="btn btn-sm btn-default btn-file-rename" data-id="{{- mediaFile.id -}}">
        <i class="fa fa-i-cursor" aria-hidden="true"></i> {{- buttonLabel|default('media_library.file.rename.title'|trans) -}}
    </button>
    {%- endif -%}
{%- endblock media_lib_button_file_rename -%}

{% block button_revision %}
    {%- if is_granted('ROLE_WEBMASTER') -%}
        <a class="btn btn-sm btn-default" href="{{ path('emsco_data_new_draft', { 'type': mediaFile.document.contentType, 'ouuid': mediaFile.id  }) }}">
            <i class="fa fa-pencil"></i> Edit
        </a>
    {%- else -%}
        <a class="btn btn-sm btn-default" href="{{ path('emsco_view_revisions', { 'type': mediaFile.document.contentType, 'ouuid': mediaFile.id  }) }}">
            <i class="fa fa-archive"></i> Show revision
        </a>
    {%- endif -%}
{% endblock button_revision %}

{%- block media_lib_button_files_delete -%}
    {% trans_default_domain 'emsco-component' %}
    {%- if mediaFolder is defined and mediaFolder.path != '/Manuals' or is_granted('ROLE_WEBMASTER') -%}
        <button class="btn btn-sm btn-default btn-files-delete" data-modal-size="md">
            <i class="fa fa-trash" aria-hidden="true"></i> {{- buttonLabel|default('media_library.files.delete.title'|trans({ '%count%': selectionFiles })) -}}
        </button>
    {%- endif -%}
{%- endblock media_lib_button_files_delete -%}

{%- block media_lib_button_files_move -%}
    {%- if mediaFolder is defined and mediaFolder.path == '/Manuals' -%}
        {%- if is_granted('ROLE_WEBMASTER') -%}{{ parent() }}{%- endif -%}
    {%- else -%}
        {{ parent() }}
    {%- endif -%}
{%- endblock media_lib_button_files_move -%}

{% block media_lib_modal_preview_footer %}
    {% trans_default_domain 'emsco-component' %}
    <div class="text-center" style="width: 100%;">
        <div class="btn-group">
            <button class="btn btn-sm btn-default btn-preview-prev disabled">
                <i class="fa fa-angle-double-left"></i>
                {{ 'media_library.file.view.previous'|trans }}
            </button>
            {{- template.block('file_download_file', _context)|raw -}}
            {{- template.block('button_revision', _context)|raw -}}
            <button class="btn btn-sm btn-default btn-preview-next disabled">
                {{ 'media_library.file.view.next'|trans }}
                <i class="fa fa-angle-double-right"></i>
            </button>
        </div>
    </div>
{% endblock media_lib_modal_preview_footer %}

{% block file_download_file %}
    <a class="btn btn-sm btn-default" href="{{ ems_asset_path(mediaFile.file, {_disposition: 'attachment'}) }}">
        <i class="fa fa-download"></i> Download file
    </a>
{% endblock file_download_file %}