{%- extends '@EMSCore/components/json_menu_nested/template.twig' -%}

{%- block build_context -%}
    {%- set environments = ['preview', 'live']|map(e => e|emsco_get_environment) -%}
    {%- do template.context.append({
        'environments': environments,
        'contentTypes': {
            'page': 'ems_standard_page'|emsco_get_content_type,
        }
    }) -%}

    {%- if render is defined and render.loadItems|length > 0 -%}
        {%- set menuIds = render.loadItems|map((item) => item.id)|keys -%}
        {%- set docs = [] -%}

        {%- set searchPaths = {
            'index': 'default'|emsco_get_environment.alias,
            '_source': ["#{locale}.paths"],
            'size': 1,
            'body': { 'query': { 'term': { '_id': { 'value': structureId } } } }
        }|emsco_search_query -%}
        {%- set allPaths = searchPaths.hits.hits|reduce((carry, h) => carry|default([])|merge(h._source.(locale).paths|default([]))) -%}

        {%- for env in environments -%}
            {%- set envSearchResult = {
                "index": env.alias,
                "size": 5000,
                "body": {
                    "_source": ['structure_item', 'label', ("#{locale}.title"), ("#{locale}.show")],
                    "query":  { "bool": { "must": [
                        { "terms": { "_contenttype": ['ems_standard_page'] } },
                        { "terms": { "structure_item": (menuIds) } }
                    ] } }
                }
            }|emsco_search_query.hits.hits|map(h => h._source|merge({
                'id': h._id,
                'emsId': ("#{h._source._contenttype}:#{h._id}")
            }))|ems_array_key('id') -%}

            {%- set docs = docs|merge({ (env.name): (envSearchResult) }) -%}
        {%- endfor -%}

        {%- do template.context.append({
            'docs': docs,
            'infos': docs.preview|map((doc) => doc.emsId)|emsco_documents_info,
            'paths': allPaths|ems_array_key('uid'),
        }) -%}

    {%- endif -%}
{%- endblock build_context -%}

{%- block jmn_item_row -%}
    {%- set itemDocs = docs.preview|filter(d => d.structure_item == item.id) -%}
    {%- set itemDoc = itemDocs|first -%}
    {%- set info = itemDoc ? infos.(itemDoc.emsId)|default(false) -%}
    {%- set contentType = contentTypes.(item.type)|default(false) -%}
    {{ parent() }}
{%- endblock -%}

{%- block jmn_title -%}
    <h2 class="h4 jmn-info"
        data-info="{{ { 'locales': locales, 'contentTypes': contentTypes|map(c => c.name) }|json_encode|e('html_attr') }}"
    >{{ structureTitle }}</h2>
{%- endblock -%}

{%- block jmn_button_add_menu -%}
    {{ parent() }}
    <li>
        <button class="ems-add-existing-page dropdown-item"
                data-modal-size="lg"
                data-jmn-modal-custom="modal_existing_page">
            <i class="fa fa-sign-in" aria-hidden="true"></i>Existing page
        </button>
    </li>
{%- endblock jmn_button_add_menu -%}

{%- block jmn_button_item_more -%}
    {%- set menuMoreItems = menuMoreItems|default([
        'jmn_button_item_view',
        'jmn_button_item_edit',
        'jmn_button_item_detach',
        'jmn_button_item_delete',
    ]) -%}
    {{ parent() }}
{%- endblock jmn_button_item_more -%}

{%- block jmn_button_item_delete -%}
    {% if info == false and item.children|length == 0 %}{{ parent() }}{% endif %}
{%- endblock jmn_button_item_delete -%}

{%- block jmn_button_item_detach -%}
    {%- if info -%}
        <button class="btn-detach" data-item-id="{{ item.id }}" data-doc-type="{{ contentType.name }}" data-doc-id="{{ info.id.ouuid }}">
            Detach
        </button>
    {%- endif -%}
{%- endblock jmn_button_item_detach -%}

{%- block jmn_item_title -%}
    {%- set itemLabel = item.object.(locale).label|default('missing path') -%}
    {%- if contentType is defined and item.type == 'page' -%}
        {%- if itemDoc -%}
            <a href="{{ path('emsco_view_revisions', { 'type': contentType.name, 'ouuid': itemDoc.id })  }}">
                {{ itemDoc.(locale).title|default(itemLabel) }}
            </a>
        {%- else -%}
            <span class="text-gray">{{ itemLabel }}</span>
        {%- endif -%}
    {%- else -%}
        {{ itemLabel }}
    {%- endif -%}
{%- endblock jmn_item_title -%}

{%- block jmn_column_content -%}Content{%- endblock -%}

{%- block jmn_column_status -%}
    <div>Publication status</div>
    {%- for env in environments -%}<div>{{ env.label }}</div>{%- endfor -%}
{%- endblock -%}

{%- block jmn_cell_content -%}
    {%- if contentType -%}
        {%- if itemDocs|length == 0 -%}
            <button class="json-post-button btn btn-sm btn-default btn-new" data-item="{{ item.data|json_encode|e('html_attr') }}">
                <i class="fa fa-plus"></i>&nbsp;
                Create {{ item.type }}
            </button>
        {%- elseif itemDocs|length == 1 -%}
            {%- set itemPath = paths.(item.id)|default(false) -%}
            {%- if itemPath -%}
                {%- set showEnvs = [] -%}
                {%- for env in environments -%}
                    {%- set envDoc = docs.(env.name)|filter(d => d.structure_item == item.id)|first -%}
                    {%- if envDoc.(locale).show|default(false) -%}
                        {%- set showEnvs = showEnvs|merge([env]) -%}
                    {%- endif -%}
                {%- endfor -%}
                {%- if showEnvs|length > 0 -%}
                    <div class="btn-group">
                        <button class="btn btn-sm btn-default dropdown-toggle" type="button" data-toggle="dropdown">
                            <i class="fa fa-eye"></i>&nbsp;Show <span class="caret"></span>
                        </button>
                        <ul class="dropdown-menu pull-right">
                            {%- for showEnv in showEnvs -%}
                                <li><a target="_blank" href="{{ "/channel/#{showEnv.name}/#{locale}/#{itemPath.path}" }}">{{ showEnv.label }}</a></li>
                            {%- endfor -%}
                        </ul>
                    </div>
                {%- endif -%}
            {%- endif -%}
            {%- if is_granted(contentType.roles.edit) -%}
                <a class="btn btn-sm btn-primary" href="{{- path('emsco_data_new_draft', { 'type': contentType.name, 'ouuid': itemDoc.id }) -}}">
                    <i class="fa fa-pencil"></i>&nbsp;Edit
                </a>
            {%- endif -%}
        {%- else -%}
            <div class="col-xs-12 text-center">
                Error: multiple metas are attached to this item
            </div>
        {%- endif -%}
    {%- endif -%}
{%- endblock -%}

{%- block jmn_cell_status -%}
    {%- if info is defined and info -%}
        {%- for env in environments -%}
            {%- if info.defaultEnvironment.name == env -%}
                {%- if info.hasDraft -%}
                    <span class="jmn-badge label label-warning col-sm-12">Draft</span>
                {%- else -%}
                    <span class="jmn-badge label label-success col-sm-12">Published</span>
                {%- endif -%}
            {%- else -%}
                {%- if info.aligned(env) -%}
                    <span class="jmn-badge label label-success">Published</span>
                {%- elseif info.published(env) -%}
                    <span class="jmn-badge label label-warning">Outdated</span>
                {%- else -%}
                    <span class="jmn-badge label label-default">Unavailable</span>
                {%- endif -%}
            {%- endif -%}
        {%- endfor -%}
    {%- endif -%}
{%- endblock -%}

{%- block modal_existing_page_title -%}<i class="fa fa-sign-in" aria-hidden="true"></i>&nbsp;Existing page{%- endblock modal_existing_page_title -%}

{%- block modal_existing_page_body -%}
    {%- set columns = [
        { "label": "Select", "template": (block('table_existing_column_select')) },
        {
            "label": ("#{locale|language_name}"),
            "template": "
                <a href=\"{{ path('data.revisions', { ouuid: data.id, type: data.contentType }) }}\">
                    {{ data.source.('#{locale}').title|default('???') }}
                </a>
            ",
            "orderField": ("#{locale}.title.alpha_order")
        },
        { "label": "Last Author", "template": (block('table_existing_column_last_update_by')), "orderField": "_finalized_by" },
        { "label": "Last Update", "template": (block('table_existing_column_last_update')), "orderField": "_finalization_datetime" },
        { "label": "Preview", "template": (block('table_existing_column_preview')) },
        { "label": "Live", "template": (block('table_existing_column_live')) },
    ] -%}
    {%- set rowContext = "{%- set docInfo = [line.data.contentType, line.data.id]|join(':')|emsco_document_info -%}" -%}
    <div id="jmn-existing-table">
        {{ emsco_datatable(['preview'],['ems_standard_page'], {
            "frontendOptions": { "order": [[3, 'desc']] },
            'row_context': rowContext,
            "columns": columns,
            "empty_query": { "bool": {
                "must_not": [ { "exists": { "field": "structure_item" } } ]
            } },
            "query": { "bool": {
                "must_not": [ { "exists": { "field": "structure_item" } } ],
                "must": [
                    {
                        "multi_match": {
                            "fields": [ "live_search", "live_search._2gram","live_search._3gram"],
                            "query": "%query%",
                            "operator": "and",
                            "type": "bool_prefix"
                        }
                    }
                ]
            } },
        }) }}
    </div>
{%- endblock modal_existing_page_body -%}

{%- block modal_existing_page_footer -%}
    <div class="pull-right">
        <button type="button" class="btn btn-sm btn-default" data-dismiss="modal">Cancel</button>
    </div>
{%- endblock modal_existing_page_footer -%}

{%- block table_existing_column_select -%}
{%- verbatim -%}
    <div style="width: 80px;">
        {%- if docInfo.hasDraft -%}
            <span class="label label-default">In draft</span>
        {%- else -%}
            <button class="btn btn-sm btn-default btn-add-existing-content" data-doc-id="{{ data.id }}" data-item-type="page" data-content-type="{{ data.contentType }}">Select</button>
        {%- endif -%}
    </div>
{%- endverbatim -%}
{%- endblock table_existing_column_select -%}

{%- block table_existing_column_last_update_by -%}
{%- verbatim -%}
    {{ data.source._finalized_by|default ? data.source._finalized_by|emsco_display_name : '' }}
{%- endverbatim -%}
{%- endblock table_existing_column_last_update_by -%}

{%- block table_existing_column_last_update -%}
{%- verbatim -%}
    <div style="width: 150px;" data-toggle="tooltip" data-placement="top" aria-hidden="true" title="By {{ data.source._finalized_by }}" >
        {{ data.source._finalization_datetime|default ? data.source._finalization_datetime|date(date_time_format) : "N.A." }}
    </div>
{%- endverbatim -%}
{%- endblock table_existing_column_last_update -%}

{%- block table_existing_column_preview -%}
{%- verbatim -%}
    {%- if docInfo.draft -%}
        <span class="label label-warning">Draft</span>
    {%- else -%}
        <span class="label label-success">Published</span>
    {%- endif -%}
{%- endverbatim -%}
{%- endblock table_existing_column_preview -%}

{%- block table_existing_column_live -%}
{%- verbatim -%}
    {%- if docInfo.published('live') and docInfo.aligned('live') -%}
        <span class="label label-success">Published</span>
    {%- elseif docInfo.published('live') -%}
        <span class="label label-warning">Outdated</span>
    {%- else -%}
        <span class="label label-default">Unavailable</span>
    {%- endif -%}
{%- endverbatim -%}
{%- endblock table_existing_column_live -%}