{
    "name": "dockerce/ide-elasticms",
    "authors": [
        {
            "name": "Mathieu De Keyzer",
            "email": "me@theus.be"
        }
    ],
    "require": {
        "php": "^8.5",
        "symfony/framework-bundle": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "twig/twig": "^3.8",
        "elasticms/core-bundle": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "post-install-cmd": "@php tools/generate-phpstorm-twig-extension.php",
        "post-update-cmd": "@php tools/generate-phpstorm-twig-extension.php",
        "phpstorm-twig": "@php tools/generate-phpstorm-twig-extension.php"
    },
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        }
    }
}
